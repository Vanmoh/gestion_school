# Python
__pycache__/
*.py[cod]
*.sqlite3
.env
.venv/
backend/.env.supabase.local
backend/.env.render.local
backend/.env.supabase.runtime
backend/.venv_supabase/
venv/

# Django
backend/staticfiles/
backend/media/
backend/logs/*.log
backend/celerybeat-schedule

# Sauvegardes: contiennent des donnees reelles (comptes, eleves).
# Aucun dump ne doit etre versionne, quel que soit son format.
backend/backups/
frontend/gestion_school_app/backend/

# Core dumps: l'image memoire d'un processus contient la SECRET_KEY, les
# identifiants de base et les donnees en cours de traitement.
core
core.*
*.core
# Le motif `core` ci-dessus ne distingue pas un fichier d'un repertoire: il
# emportait aussi lib/core/ et test/core/ du client Flutter. Les fichiers
# ajoutes avant l'apparition du motif restaient suivis, les nouveaux
# disparaissaient des commits sans un mot -- et la compilation cassait chez
# les autres, pas chez l'auteur.
!**/lib/core/
!**/test/core/

# Flutter
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/pubspec.lock

# IDE
.vscode/
.idea/
*.iml

# Claude Code
# `settings.local.json` porte les autorisations acceptees sur ce poste: elles
# n'ont pas de sens ailleurs. Le reste de .claude/ (settings.json partages,
# skills, commandes) reste suivi pour profiter a toute l'equipe.
.claude/settings.local.json

# Captures d'ecran deposees pour signaler un defaut. Elles servent a la
# discussion, pas au depot -- et `deploy_one_click.sh` fait un `git add -A`,
# qui les embarquerait en production sans que personne le demande.
capture_a_corriger/

# Traces des rattachements de demonstration: un artefact local, qui sert a
# defaire un tirage au sort. `deploy_one_click.sh` fait `git add -A`, et
# les emporterait sinon jusqu'en production.
backend/rattachements_*.json
