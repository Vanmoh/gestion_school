DEBUG=True
# SECRET_KEY signe aussi le QR des cartes scolaires (apps/reports/
# card_verification.py). En changer invalide d'un coup toutes les cartes deja
# imprimees: elles afficheront « Carte non reconnue » au portail et devront
# etre reimprimees. Le faire si la cle a fuite -- mais en le sachant, et en
# prevoyant la reimpression.
SECRET_KEY=replace_with_secret_key
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Option 1 (Supabase / PostgreSQL cloud):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=True

# Option 2 (local Docker MySQL fallback if DATABASE_URL is empty):
DB_NAME=gestion_school
DB_USER=gestion_user
DB_PASSWORD=gestion_password
DB_HOST=db
DB_PORT=3306

USE_X_FORWARDED_HOST=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Cache partage: obligatoire en production, sinon chaque worker gunicorn
# compte les quotas de debit dans son coin. Vide = cache local en memoire.
CACHE_URL=

# Quotas de debit (format DRF: "<nombre>/<periode>")
THROTTLE_LOGIN=10/min
THROTTLE_ANON=60/min
THROTTLE_USER=2000/hour

# Stockage objet des fichiers televerses (photos eleves, logos, tampons,
# signatures, justificatifs, pieces jointes du chat).
# Vide = disque local: acceptable en dev, mais sur un hebergement a disque
# ephemere les fichiers sont perdus a chaque deploiement.
# Supabase Storage: endpoint https://<projet>.supabase.co/storage/v1/s3,
# cles a creer dans Project Settings > Storage > S3 access keys.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
# URLs signees a duree limitee plutot qu'un bucket public: ces fichiers sont
# des donnees personnelles. Ne passer a False qu'en connaissance de cause.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# Sauvegarde automatique quotidienne (heure locale TIME_ZONE).
# Elle n'est durable que si le stockage objet ci-dessus est configure.
BACKUP_HOUR=2
BACKUP_MINUTE=30

# Supervision des erreurs. Vide = Sentry desactive.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Durcissement HTTPS, actif seulement si DEBUG=False.
# Mettre SECURE_SSL_REDIRECT=False si le health check du proxy arrive en HTTP.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Bibliotheque: relayer depuis bkalan.ml un document pas encore rapatrie.
#
# False ici parce que ce fichier est l'environnement des conteneurs locaux
# (infra/docker-compose.yml), c'est-a-dire du serveur d'une ecole, qui n'a
# pas Internet. Le relais y echouerait de toute facon; ferme, il echoue tout
# de suite et le catalogue grise d'avance les documents concernes au lieu de
# faire patienter puis echouer.
#
# Rapatrier le fonds AVANT de fermer: `manage.py import_bkalan`.
# Voir docs/OPERATIONS_BIBLIOTHEQUE.md, §8.
LIBRARY_RELAY_SOURCE=False

# Envoi des bulletins aux familles par WhatsApp.
# Voir docs/ENVOI_BULLETINS_WHATSAPP.md.
#
# Indicatif applique aux numeros saisis sans lui (« 76 12 34 56 »), sans le
# « + », et nombre de chiffres d'un numero national. Le second sert a refuser
# un numero recopie a moitie, que la seule regle E.164 laisse passer.
DEFAULT_PHONE_COUNTRY_CODE=223
NATIONAL_PHONE_LENGTH=8

# Racine des liens envoyes aux familles. A renseigner des que l'API repond
# derriere un domaine different de celui qu'atteint le telephone d'un parent:
# vide, le lien est construit a partir de la requete, qui peut arriver par une
# adresse interne inatteignable depuis l'exterieur.
PUBLIC_BASE_URL=

# Duree de validite d'un lien de bulletin, en heures. Assez long pour qu'un
# parent ouvre le message le lendemain, assez court pour qu'un lien transfere
# ne circule pas toute l'annee.
BULLETIN_LINK_TTL_HOURS=72
